<%- include("partials/header", { title }) %>

<h1><%= category.name %></h1>

<p>
  <a href="/edit-category/<%= category.category_id %>">
    Edit Category
  </a>
</p>

<ul class="project-list">

  <% projects.forEach(project => { %>

    <li>

      <a href="/project/<%= project.project_id %>">
        <%= project.title %>
      </a>

    </li>

  <% }) %>

</ul>

<%- include("partials/footer") %>